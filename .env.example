# Server configuration
HOST=0.0.0.0
PORT=8080
RUST_LOG=info
CORS_ALLOWED_ORIGINS=*

# Security & Authentication (Production-grade, short-lived tokens)
JWT_SECRET=super-secure-production-random-jwt-secret-min-32-chars
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hackathon
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hackathon

# Redis & Redis Streams
REDIS_URL=redis://localhost:6379

# NATS JetStream
NATS_URL=nats://localhost:4222

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hackathon-bucket
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Frontend Web Application (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
